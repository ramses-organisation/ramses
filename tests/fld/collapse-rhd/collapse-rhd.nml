!This namelist contains various input parameters for RAMSES runs

&RUN_PARAMS
hydro=.true.
poisson=.true.
nrestart=0
ncontrol=10
nremap=2
nsubcycle=3*1,35*2
verbose=.false.
fld=.true.
/

&AMR_PARAMS
levelmin=5
levelmax=18
ngridmax=100000
npartmax=5000
nexpand=30*4
boxlen=1.9140529831524967E-02 ! to be changed is alpha_dense_core changes in order to always have in code units the cloud radius r0=boxlen/4
/

&BOUNDARY_PARAMS
/

&INIT_PARAMS
condinit_kind ='collapse'
bb_test=.true.
alpha_dense_core=0.1
beta_dense_core=0.01d0
crit_dense_core=0.1
delta_rho=0.1d0
/

&OUTPUT_PARAMS
noutput=1
tout=8.99e-05
/

&POISSON_PARAMS
gravity_type=0
epsilon=1d-4
cg_levelmin=7
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.6
slope_type=1
scheme='muscl'
riemann='hlld'
riemann2d='hlld'
pressure_fix=.true.
/

&UNITS_PARAMS
units_density=0.383460000000000E-23
units_time=1.9773204094687982E+15
units_length=3.08d18
/

&COOLING_PARAMS
eos=.true.
T_eos=10d0
mu_gas=2.31d0
/

&REFINE_PARAMS
jeans_refine=30*8.
!iso_jeans=.false.
interpol_var=0
interpol_type=1
/

&RADIATION_PARAMS
grey_rad_transfer=.true.
epsilon_diff=1.d-12
fit_semenov=.false.
fld_limiter='minerbo'
Tr_floor=10.0d0
robin=1.0
energy_fix=.true.
/
