! Jiang & Oh (2018) 4.2.2 -- 1D colliding flow (u = +10 / -10) with cosmic rays.
! CR energy comes from crmom_region per region geometry; the CR flux is set from
! the gas velocity in cr_condinit (F = 4/3 v_gas E_cr). NDIM=1 build.
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=100
nsubcycle=10*2,
static_gas=.false.
/

&AMR_PARAMS
levelmin=10
levelmax=10
ngridmax=10000
nexpand=1
boxlen=10.0
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 2, 2
d_bound = 1,1
u_bound=10,-10
v_bound=0,0
w_bound=0,0
p_bound=1,1
A_bound=1.,1.
B_bound=0.,0.
C_bound=0.,0.
! [stripped: crmom_bound not in sno &boundary_params; unused for reflexive
!  (bound_type=2) walls, which copy CR energy + flip flux -- never read in cral]
! crmom_bound(:,1) = 50.,50.
! crmom_bound(:,2) = 666.666667, -666.666667
/

&CR_PARAMS
cr_legacy_output=.true.
jiang_test='422'
Dcr=0.1
cr_c_fraction=3.3356409297285193e-9   ! reduced light speed = 100
cr_advect=.true.
mom_streaming_heating=.true.
mom_streaming_diffusion=.true.
v_alfven=1.0
cr_f_taucell=1.0
cr_nsubcycle=1
cr_varvmax=.false.
! CR energy per region (cral region_condinit reads this); replicated by
! cr_region_condinit in patch/cr_tests/cr_condinit.f90 for the separated module.
crmom_region(:,1) = 50.,50.
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=2.5,7.5
length_x=5,5
d_region=1.0,1.0
u_region=10.0,-10.0
v_region=0.0,0.0
w_region=0.0,0.0
p_region=1.0,1.0
A_region=1.0,1.0
B_region=0.0,0.0
C_region=0.0,0.0
/

&OUTPUT_PARAMS
noutput=3
tout=0.05,0.25,0.5
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
slope_type=1
riemann='hlld'
pressure_fix=.true.
/

&REFINE_PARAMS
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
