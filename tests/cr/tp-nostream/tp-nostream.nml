This namelist contains various input parameters for RAMSES runs

&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=100
nsubcycle=10*2,
static_gas=.false.
nrestart=0
/

&AMR_PARAMS
levelmin=9
levelmax=9
ngridmax=10000
nexpand=1
boxlen=10.0
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 3, 3
d_bound = 1,1
u_bound=0,0
v_bound=0,0
w_bound=0,0
p_bound=1,1
A_bound=1.e-13,1.e-13
B_bound=0.,0.
C_bound=0.,0.
/

&MHD_PARAMS
/

&CR_PARAMS
jiang_test='tp-nostream'
Dcr=0.003333333333
cr_c_fraction=3.3356409297285193e-9  ! light-speed=100
cr_region_u(:,1) = 3., 1.
cr_region_u(:,2) = 0., 0.
cr_boundary_u(:,1) = 3., 1.
cr_boundary_u(:,2) = 0., 0.
cr_advect=.true.
cr_streaming_heating=.false.
cr_streaming_diffusion=.false.
cr_varvmax=.false.
cr_v_alfven = 0.0
cr_f_taucell = 1.0
cr_nsubcycle=1
cr_hlle=.false.
cr_flux_correction=.true.
cr_nregion=2
cr_region_type='square','square'
cr_reg_x_center=2.5,7.5
cr_reg_length_x=5,5
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=2.5,7.5
length_x=5,5
d_region=1.0,1.0
u_region=0.0,0.0
v_region=0.0,0.0
w_region=0.0,0.0
p_region=1.0,1.0
A_region=1.d-13,1.d-13
B_region=0.0,0.0
C_region=0.0,0.0
/

&OUTPUT_PARAMS
!foutput=10
!foutput=1
tout=2.0
/

&HYDRO_PARAMS
gamma=1.6666666666667
!gamma_rad(:) = 1.3333333
courant_factor=0.8
slope_type=2
riemann='hlld'
pressure_fix=.true.
beta_fix=0.5
/

&REFINE_PARAMS
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
