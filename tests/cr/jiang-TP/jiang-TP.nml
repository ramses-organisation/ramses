! Jiang & Oh (2018) -- 1D CR "two-pressure" (TP) shock tube: a CR-energy contact
! discontinuity (E_cr=3 | 1 across x=5) evolved with CR streaming + diffusion.
! Region-based (no condinit override needed): the CR state comes from
! crmom_region(:,1)=3,1 (energy) and crmom_region(:,2)=0,0 (flux), replicated by
! cr_region_condinit in patch/cr_tests/cr_condinit.f90 for the separated module.
! Ported from ramses_cral tests/cr/TP_1D_shock/TP_1D_shock.nml: &MHD_PARAMS ->
! &CR_PARAMS, add cr_legacy_output (so osyris reads CR from the hydro files);
! crmom_bound is stripped (no such key in sno &boundary_params, and it is never
! read for reflexive bound_type=2 walls anyway). NDIM=1 build.
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=100
nsubcycle=4*2,
static_gas=.false.
/

&AMR_PARAMS
levelmin=9
levelmax=9
ngridmax=10000
nexpand=1
boxlen=10.0
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 2, 2
d_bound = 1,1
u_bound=0,0
v_bound=0,0
w_bound=0,0
p_bound=1,1
A_bound=1.e-13,1.e-13
B_bound=0.,0.
C_bound=0.,0.
! [stripped: crmom_bound not in sno &boundary_params; unused for reflexive
!  (bound_type=2) walls, which copy CR energy + flip flux -- never read in cral]
! crmom_bound(:,1) = 3., 1.
! crmom_bound(:,2) = 0., 0.
/

&CR_PARAMS
cr_legacy_output=.true.
jiang_test='TP_1D_shock'
Dcr=0.00333333333333
cr_c_fraction=3.3356409297285193e-9   ! reduced light speed = 100
cr_advect=.true.
mom_streaming_heating=.true.
mom_streaming_diffusion=.true.
cr_varvmax=.false.
cr_nsubcycle=10
cr_f_taucell=0.0
v_alfven=1.5
cr_HLLE=.true.
cr_interpolation=.true.
reduced_CR_flux_correction=.true.
! CR energy+flux per region (cral region_condinit reads these); replicated by
! cr_region_condinit in patch/cr_tests/cr_condinit.f90 for the separated module.
crmom_region(:,1) = 3., 1.
crmom_region(:,2) = 0., 0.
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=2.5,7.5
length_x=5,5
d_region=1.0,1.0
u_region=0.0,0.0
v_region=0.0,0.0
w_region=0.0,0.0
p_region=1.0,1.0
A_region=1.d-13,1.d-13
B_region=0.0,0.0
C_region=0.0,0.0
! [crmom_region moved to &CR_PARAMS: sno reads it there, not in &init_params]
/

&OUTPUT_PARAMS
noutput=3
tout=0.5,1.0,2.0
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
slope_type=2
riemann='hlld'
pressure_fix=.true.
beta_fix=0.5
/

&REFINE_PARAMS
err_grad_d=0.01
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
