! Jiang & Oh (2018) 4.2.3 -- 2D CR-blast / Sedov-type explosion with AMR.
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=1
nsubcycle=4*2,
static_gas=.false.
/

&AMR_PARAMS
levelmin=6
levelmax=7
ngridmax=100000
nexpand=1
boxlen=1.0
/

&BOUNDARY_PARAMS
nboundary=4
ibound_min=-1,+1,-1,-1
ibound_max=-1,+1,+1,+1
jbound_min= 0, 0,+1,-1
jbound_max= 0, 0,+1,-1
bound_type= 2, 2, 2, 2
/

&CR_PARAMS
jiang_test='423'
Dcr=0.1
cr_c_fraction=1e-8
cr_advect=.true.
cr_streaming_heating=.false.
cr_streaming_diffusion=.true.
cr_f_taucell=1.0
cr_nsubcycle=10
cr_varvmax=.true.
DCRmax=1d5
err_grad_cr(1)=0.05
cr_region_u(:,1)=1d-10,0.0d0
cr_nregion=2
cr_region_type='square','point'
cr_reg_x_center=0.5,0.5
cr_reg_y_center=0.5,0.5
cr_reg_length_x=10.0,1.0
cr_reg_length_y=10.0,1.0
cr_exp_region=10.0,10.0
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='point'
x_center=0.5,0.5
y_center=0.5,0.5
length_x=10.0,1.0
length_y=10.0,1.0
exp_region=10.0,10.0
d_region=1.0,0.0
u_region=0.0,0.0
v_region=0.0,0.0
w_region=0.0,0.0
p_region=1e-4,0.6666666667d0
A_region=1d-8,0.0d0
B_region=0.0,0.0
C_region=0.0,0.0
/

&OUTPUT_PARAMS
foutput=10
noutput=1
tout=0.1
/

&HYDRO_PARAMS
gamma=1.66667
courant_factor=0.8
slope_type=2
riemann='hlld'
/

&REFINE_PARAMS
err_grad_d=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
