! Jiang & Oh (2018) 4.2.1 -- 1D sinusoidal CR-energy profile, streaming +
! diffusion in a periodic box (bound_type=0 => periodic). NDIM=1 build.
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=100
nsubcycle=4*2,
static_gas=.false.
/

&AMR_PARAMS
levelmin=8
levelmax=8
ngridmax=10000
nexpand=1
boxlen=2.0
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 0, 0
/

&CR_PARAMS
cr_legacy_output=.true.
jiang_test='421'
Dcr=2.0
cr_c_fraction=3.3356409297285193e-9   ! reduced light speed = 100
mom_streaming_heating=.true.
mom_streaming_diffusion=.true.
v_alfven=1.0
cr_f_taucell=0.5
cr_nsubcycle=10
cr_varvmax=.false.
! [stripped: not in sno &cr_params] cooling_cr=.false.
! [stripped: not in sno &cr_params] epsilon_diff=1d-4
cr_advect=.true.
cr_nregion=1
cr_region_type='square'
cr_reg_x_center=1.0
cr_reg_length_x=100.0
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=1.0
length_x=100.0
d_region=1.0
u_region=0.0
v_region=0.0
w_region=0.0
p_region=1.0
A_region=1.0
B_region=0.0
C_region=0.0
/

&OUTPUT_PARAMS
noutput=2
tout=0.02,0.05
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
slope_type=1
riemann='hlld'
/

&REFINE_PARAMS
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
