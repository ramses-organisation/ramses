! Jiang & Oh (2018) 4.1.5 -- 2D CR transport along a magnetic loop (hardest 2D).
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=100
nsubcycle=4*1,
static_gas=.true.
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=100000
nexpand=1
boxlen=2.0
/

&BOUNDARY_PARAMS
nboundary=4
ibound_min=-1,+1,-1,-1
ibound_max=-1,+1,+1,+1
jbound_min= 0, 0,+1,-1
jbound_max= 0, 0,+1,-1
bound_type= 2, 2, 2, 2
/

&CR_PARAMS
jiang_test='415'
Dcr=0.1
cr_c_fraction=3.3356409297285193e-9   ! reduced light speed = 100
cr_advect=.true.
mom_streaming_heating=.false.
mom_streaming_diffusion=.false.
cr_legacy_output=.true.
cr_nregion=1
cr_region_type='square'
cr_reg_x_center=1.0
cr_reg_y_center=1.0
cr_reg_length_x=100.0
cr_reg_length_y=100.0
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=1.0
y_center=1.0
length_x=100.0
length_y=100.0
d_region=1.0
u_region=0.0
v_region=0.0
w_region=0.0
p_region=1.0d-2
A_region=0.0
B_region=0.0
C_region=0.0
/

&OUTPUT_PARAMS
noutput=2
tout=0.2,0.4
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=2
riemann='hlld'
/

&REFINE_PARAMS
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
