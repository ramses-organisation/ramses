! Jiang & Oh (2018) 4.1.3 -- 1D CR streaming/diffusion into a dense slab.
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=100
nsubcycle=4*2,
static_gas=.true.
nrestart=0
/

&AMR_PARAMS
levelmin=9
levelmax=9
ngridmax=10000
nexpand=1
boxlen=1000
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 1, 2
/

&CR_PARAMS
jiang_test='413'
Dcr=1d-6
cr_c_fraction=3.3356409297285193e-9   ! reduced light speed = 100
cr_streaming_heating=.true.
cr_streaming_diffusion=.true.
cr_f_taucell=1.0
cr_advect=.true.
cr_nregion=0
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=500.0
length_x=10000.0
d_region=1.0
u_region=0.0
v_region=0.0
w_region=0.0
p_region=2.0
A_region=1.0
B_region=0.0
C_region=0.0
/

&OUTPUT_PARAMS
noutput=3
tout=100.,200.,300.
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
slope_type=2
riemann='hlld'
/

&REFINE_PARAMS
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=2
/
