! Jiang & Oh (2018) 4.2.4 -- 1D CR-driven outflow with AMR and a variable CR
! light-speed. Density step in condinit; CR injected at the reflexive left
! boundary via cr_bound_floor. reduced_CR_flux_correction replaces the reference
! cr_godunov_fine.f90 patch (it is a namelist flag in this code). NDIM=1 build.
&RUN_PARAMS
hydro=.true.
nremap=0
ncontrol=1
nsubcycle=4*2,
static_gas=.false.
nrestart=0
/

&AMR_PARAMS
levelmin=7
levelmax=11
ngridmax=10000
nexpand=1
boxlen=4000
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 1, 2
/

&CR_PARAMS
cr_legacy_output=.true.
jiang_test='424'
cr_bound_floor=3.0
Dcr=1d-6
cr_c_fraction=3.3356409297285193e-10   ! reduced light speed = 10
cr_advect=.true.
mom_streaming_heating=.true.
mom_streaming_diffusion=.true.
cr_f_taucell=0.5
cr_nsubcycle=10
cr_varvmax=.true.
reduced_CR_flux_correction=.true.
err_grad_crmom(1)=0.05   ! moved from &refine_params (CR refinement lives in &cr_params)
cr_nregion=0
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=2000.0
length_x=10000.0
d_region=1.0
u_region=0.0
v_region=0.0
w_region=0.0
p_region=1.0
A_region=1.0
B_region=0.0
C_region=0.0
/

&OUTPUT_PARAMS
noutput=3
tout=400.,600.,800.
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
slope_type=2
riemann='hlld'
pressure_fix=.true.
/

&REFINE_PARAMS
err_grad_d=0.05
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=1
/
