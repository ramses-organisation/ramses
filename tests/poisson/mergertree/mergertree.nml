&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nremap=5
nsubcycle=2,2
clumpfind=.true.
unbind=.true.
make_mergertree=.true.
/

&OUTPUT_PARAMS
aout=0.080,0.090,0.100,0.110,0.120,0.1355
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='cosmo_64'
/

&AMR_PARAMS
levelmin=6
levelmax=8
ngridtot=1100000
nparttot=3000000
nexpand=1
/

&REFINE_PARAMS
m_refine=2,2
interpol_var=1
interpol_type=0
/

&POISSON_PARAMS
epsilon=1d-4
/

&CLUMPFIND_PARAMS
relevance_threshold=3
density_threshold=80
saddle_threshold=200
mass_threshold=10
ivar_clump=0
clinfo=.true.
/

&MERGERTREE_PARAMS
nmost_bound=200
make_mock_galaxies=.false.
/
