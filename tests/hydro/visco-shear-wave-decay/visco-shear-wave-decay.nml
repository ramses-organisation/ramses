
&RUN_PARAMS
hydro=.true.
nremap=10
nsubcycle=10*1
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=50000
nexpand=10*2
boxlen=1.0
/

&INIT_PARAMS
condinit_kind="shear_wave"
nregion=1
region_type(1)='square'
exp_region=10.0
x_center=0.5
y_center=0.5
length_x=1.0
length_y=1.0
d_region=1.0
u_region=0.0d0
v_region=0.0d0
p_region=1.0
/

&OUTPUT_PARAMS
tout=0.5
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=2
riemann='hllc'
pressure_fix=.true.
add_viscosity=.true.
viscosity_kind="constant_uniform"
nu_viscosity_bulk=0.0d0
nu_viscosity_shear=0.05d0
/
