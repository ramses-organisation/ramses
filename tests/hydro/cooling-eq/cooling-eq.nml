This is the RAMSES parameter file for the equilibrium cooling module test.
It is a 2D run with 2*2 (i.e. four) cells, hydro-static, and with a z=0 HM UV backgound,
so there is no flow between the cells and the only evolution is therefore the radiative
cooling (and heating due to the UVB) in each cell.

&RUN_PARAMS
hydro=.true.
static_gas=.true.
/

&AMR_PARAMS
levelmin=1
levelmax=1
ngridmax=100
boxlen=1
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
/

&INIT_PARAMS
nregion=4
region_type='square'
x_center=0.25, 0.75, 0.25, 0.75
y_center=0.25, 0.25, 0.75, 0.75
length_x=0.5, 0.5, 0.5, 0.5
length_y=0.5, 0.5, 0.5, 0.5
exp_region=10
d_region=3d-2, 3d0, 3d-2, 3d0      ! cm-3
p_region=  0.0260938, 2.6094,  2609.38, 260938.5    ! 1e2, 1e2, 1e7, 1e7 K
/

&OUTPUT_PARAMS
noutput=200
! 200 outputs, evenly log-spaced, ending at 500 myrs
tout = 0.0003, 0.00032239391, 0.00034645944, 0.00037232137, 0.00040011381, 0.00042998085, 0.00046207735, 0.00049656975, 0.00053363687, 0.00057347092, 0.00061627843, 0.00066228138, 0.00071171827, 0.00076484545, 0.00082193837, 0.00088329308, 0.00094922769, 0.0010200841, 0.0010962296, 0.0011780592, 0.001265997, 0.0013604991, 0.0014620554, 0.0015711925, 0.0016884763, 0.0018145149, 0.0019499619, 0.0020955194, 0.0022519423, 0.0024200416, 0.0026006889, 0.0027948208, 0.0030034441, 0.0032276402, 0.0034685718, 0.0037274881, 0.0040057315, 0.0043047447, 0.0046260783, 0.0049713982, 0.0053424949, 0.0057412927, 0.0061698593, 0.0066304169, 0.0071253533, 0.007657235, 0.0082288197, 0.0088430712, 0.0095031742, 0.010212552, 0.010974881, 0.011794116, 0.012674504, 0.01362061, 0.014637339, 0.015729963, 0.016904147, 0.01816598, 0.019522004, 0.020979251, 0.022545276, 0.024228198, 0.026036745, 0.027980294, 0.030068921, 0.032313456, 0.034725538, 0.037317673, 0.040103301, 0.043096867, 0.046313891, 0.049771054, 0.053486282, 0.057478838, 0.061769424, 0.066380287, 0.071335334, 0.076660257, 0.082382666, 0.088532232, 0.09514084, 0.10224276, 0.10987481, 0.11807656, 0.12689055, 0.13636246, 0.14654143, 0.15748021, 0.16923553, 0.18186835, 0.19544416, 0.21003336, 0.22571158, 0.24256013, 0.26066636, 0.28012415, 0.3010344, 0.32350552, 0.34765403, 0.37360514, 0.4014934, 0.43146343, 0.4636706, 0.49828192, 0.53547685, 0.57544825, 0.61840337, 0.66456493, 0.71417228, 0.76748264, 0.82477242, 0.88633868, 0.95250064, 1.0236013, 1.1000095, 1.1821212, 1.2703622, 1.3651901, 1.4670966, 1.57661, 1.6942982, 1.8207714, 1.9566853, 2.1027448, 2.259707, 2.4283859, 2.6096561, 2.8044574, 3.0137999, 3.2387691, 3.4805315, 3.7403405, 4.0195433, 4.3195875, 4.642029, 4.9885396, 5.3609159, 5.7610887, 6.191133, 6.6532786, 7.1499216, 7.6836372, 8.2571928, 8.8735621, 9.5359412, 10.247765, 11.012723, 11.834782, 12.718206, 13.667574, 14.687808, 15.7842, 16.962433, 18.228617, 19.589316, 21.051588, 22.623012, 24.311737, 26.12652, 28.0767