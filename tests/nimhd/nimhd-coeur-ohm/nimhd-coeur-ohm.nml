&RUN_PARAMS  
hydro=.true.
poisson=.true.
nrestart=0
ncontrol=10
nremap=2
nsubcycle=3*1,35*2
verbose=.false.
/

&AMR_PARAMS 
levelmin=5
levelmax=18
ngridmax=100000
nexpand=30*2
boxlen=1.9140529831524967d-2
/

&INIT_PARAMS
condinit_kind='collapse'
mass_c=1.
alpha_dense_core=0.1
beta_dense_core =0.01d0
crit_dense_core =0.1
delta_rho=0.1d0
theta_mag=0.0
Mach=0.0d0
/

&OUTPUT_PARAMS
foutput=1000000
noutput=2
tout=0,8.99e-05
/

&POISSON_PARAMS 
gravity_type=0
epsilon=1d-4
cg_levelmin=7
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.6
slope_type=1
scheme='muscl'
riemann='hlld'
riemann2d='hlld'
pressure_fix=.true.
/

&UNITS_PARAMS
units_density= 3.83460000000000E-24      ! so that density in code units is equal to density in part/cc
units_length=3.08000000000000E+18        ! 1 pc in cm
units_time= 1.97732040946880E+15         ! so that G=1 in code units
/

&COOLING_PARAMS
barotropic_eos=.true.
barotropic_eos_form='double_polytrope' ! type of barotropic eos
polytrope_rho=1d-13                    ! sets rho_ad in EOS, in g/cm3
polytrope_index=1.666667               ! sets gamma in EOS
T_eos=10d0                             ! sets T0 in EOS, in K
mu_gas=2.31d0                          ! molecular weight
/

&REFINE_PARAMS 
jeans_refine=30*8.
interpol_var=0
interpol_type=1
/

&NONIDEALMHD_PARAMS
nambipolar=.false.
nmagdiffu=.true.
nminitimestep=.true.
resistivity_method=2
coefad=0.1d0
coefalfven=0.5
rho_threshold=5d5
coefdtohm=0.2d0
gammaAD=3.5d13 
/


