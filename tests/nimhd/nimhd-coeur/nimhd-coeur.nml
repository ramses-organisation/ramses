&RUN_PARAMS  
hydro=.true.
poisson=.true.
nrestart=0
ncontrol=1
nremap=2
nsubcycle=3*1,35*2
verbose=.false.
/

&AMR_PARAMS 
levelmin=5
levelmax=15
ngridmax=100000
nexpand=30*4
boxlen=1.9140529831524967d-2
/

&INIT_PARAMS
condinit_kind='coeur'
/

&OUTPUT_PARAMS
tend=8.899d-5
/

&POISSON_PARAMS 
gravity_type=0
epsilon=1d-4
/

&HYDRO_PARAMS
gamma=1.66666667
courant_factor=0.7
slope_type=1
scheme='muscl'
riemann='hlld'
riemann2d='hlld'
pressure_fix=.false.
/

&UNITS_PARAMS
units_density= 3.83584509e-24      ! so that density in code units is equal to density in part/cc
units_length= 3.0856776e+18        ! 1 pc in cm
units_time= 1.9769994708456518e15  ! so that G=1 in code units
/

&COOLING_PARAMS
barotropic_eos=.true.
barotropic_eos_form='double_polytrope' ! type of barotropic eos
polytrope_rho=1d-13                    ! sets rho_ad in EOS, in g/cm3
polytrope_index=1.666667               ! sets gamma in EOS
T_eos=10d0                             ! sets T0 in EOS, in K
mu_gas=2.31d0                          ! molecular weight
/

&REFINE_PARAMS 
jeans_refine=30*8.
interpol_var=1
interpol_type=0
/

&NONIDEALMHD_PARAMS
nambipolar=.true.
nmagdiffu=.true.
nminitimestep=.true.
resistivity_method=2
coefad=0.1d0
coefalfven=0.3
rho_threshold=1d5
coefdtohm=0.2d0
/


